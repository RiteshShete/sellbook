# Copy to .env.local. Public anon key ONLY - never put any secret or admin key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional (all public values; none is a secret)
# Turn the customer storefront on in this build ("true"); leave empty for the owner app only.
VITE_STOREFRONT_ENABLED=
# Cloudflare Turnstile SITE key (not the secret) for sign-up and password-reset checks. Empty = no check (local).
VITE_TURNSTILE_SITE_KEY=
# WhatsApp number (digits with country code) people with no recovery email can contact, e.g. 919876543210.
VITE_SUPPORT_WHATSAPP=

# Web push: the PUBLIC VAPID key (make a pair with: node scripts/gen-vapid.mjs). The private half goes only into the push-owner function's secrets.
VITE_VAPID_PUBLIC_KEY=
